{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeyAura",
  "version": "0.1.5",
  "identifier": "io.jonathanlaf.layerhud",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "overlay",
        "title": "KeyAura",
        "width": 940,
        "height": 380,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "resizable": true,
        "skipTaskbar": true,
        "acceptFirstMouse": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "macOS": {
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzNzY4MjAwMkJDMkFCMTgKUldRWXE4SXJBSUoyZzAzL2pic2Y4cTFMUEVoVjQ4NEVzUVc3dkgyUG91Nlc0SVBVMlhKRzVNbFAK",
      "endpoints": [
        "https://github.com/jonathanlaf/keyaura/releases/latest/download/latest.json"
      ]
    }
  }
}
